[Unit]
Description=Periodic host telemetry snapshot for the AvelRen API
Documentation=file:///opt/avelren/deploy/telemetry-snapshot.sh

[Timer]
# Every minute: the collector's cycle is also per-minute, so snapshot freshness ≤ freshness
# of observations. The API treats a snapshot as stale after 5 min — a fourfold margin.
OnBootSec=30s
OnUnitActiveSec=1min
AccuracySec=5s
Persistent=true

[Install]
WantedBy=timers.target
