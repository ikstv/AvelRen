[Unit]
Description=AvelRen backup to Google Drive
After=docker.service
Requires=docker.service

[Service]
# The script (deploy/backup.sh) fail-closes if AVELREN_BACKUP_PASSWORD is empty;
# without an EnvironmentFile it would run into that fail-close nightly. Absence
# of `-` prefix is deliberate: a missing file must fail the unit loudly at
# systemd load, not silently at line 37 of the script — loud earlier > loud later.
EnvironmentFile=/etc/avelren/backup.env
Type=oneshot
ExecStart=/usr/local/sbin/avelren-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# The backup isn't time-critical, but the dump loads the DB — stay out of the collector's way.
Nice=10
IOSchedulingClass=idle
