[Unit]
Description=AvelRen backup to Google Drive
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/avelren-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# The backup isn't time-critical, but the dump loads the DB — stay out of the collector's way.
Nice=10
IOSchedulingClass=idle
