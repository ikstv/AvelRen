# Caddy obtains and renews the Let's Encrypt certificate for this name on its own.
https://api.bordersignal.pp.ua {
	encode gzip

	handle /api/* {
		# Cap the request body before it reaches the API: the unauthenticated
		# POST /devices reads the body into memory, so without a ceiling a
		# single large request is a cheap way to exhaust memory. 64KB with
		# headroom covers the largest legitimate payload (registration/subscriptions).
		request_body {
			max_size 64KB
		}
		uri strip_prefix /api
		reverse_proxy api:8000 {
			header_up -X-Forwarded-For
			header_up -X-AvelRen-Client-IP
			header_up X-AvelRen-Client-IP {http.request.remote.host}
		}
	}

	handle {
		respond "AvelRen API" 200
	}
}

# We keep bare-IP access for diagnostics from the server itself, but without
# HTTPS: you can't issue a certificate for an IP address, and the app talks to the domain.
:80 {
	redir https://{host}{uri} permanent
}
