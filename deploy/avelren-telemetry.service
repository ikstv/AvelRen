[Unit]
Description=Host telemetry snapshot for the AvelRen API
Documentation=file:///opt/avelren/deploy/telemetry-snapshot.sh

# The snapshot is only useful while Docker is alive, but it doesn't block host startup.
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
# The path matches where the runbook installs the script. We deliberately do NOT
# point at /opt/avelren/deploy/…: the unit must not depend on the git checkout, and
# deploy must not mutate the installed unit with sed — otherwise what lives in systemd
# drifts from what lives in Git.
ExecStart=/usr/local/sbin/avelren-telemetry-snapshot

# Least privilege: the script reads /proc and /run/reboot-required and writes to
# /var/lib/avelren-telemetry — that's all. We restrict access to everything else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/avelren-telemetry
ReadOnlyPaths=/proc /run
# openssl s_client pulls in network access to api.bordersignal.pp.ua:443.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
