{
  "version": 1,
  "components": {
    "backend_core": {
      "workflow": "backend-core.yml",
      "paths": [
        "services/backend/**",
        "scripts/verify_core_provenance.py",
        "docs/CORE-PROVENANCE.json",
        "docs/DB-PROVENANCE.json",
        "docs/API-PROVENANCE.json",
        "docs/WATCHDOG-PROVENANCE.json",
        "ops/telemetry-snapshot.sh",
        "db/**",
        ".gitattributes",
        ".github/workflows/backend-core.yml"
      ]
    },
    "api": {
      "workflow": "api.yml",
      "paths": [
        "services/backend/**",
        "db/**",
        "ops/**",
        "scripts/test_database.sh",
        "scripts/verify_core_provenance.py",
        "docs/CORE-PROVENANCE.json",
        "docs/DB-PROVENANCE.json",
        "docs/API-PROVENANCE.json",
        "docs/WATCHDOG-PROVENANCE.json",
        ".gitattributes",
        ".github/workflows/api.yml"
      ]
    },
    "database": {
      "workflow": "database.yml",
      "paths": [
        "db/**",
        "ops/**",
        "services/backend/**",
        "docker-compose.yml",
        ".env.example",
        ".gitignore",
        "scripts/test_database.sh",
        "scripts/verify_core_provenance.py",
        "docs/CORE-PROVENANCE.json",
        "docs/DB-PROVENANCE.json",
        "docs/API-PROVENANCE.json",
        "docs/WATCHDOG-PROVENANCE.json",
        ".gitattributes",
        ".github/workflows/database.yml"
      ]
    },
    "watchdog": {
      "workflow": "watchdog.yml",
      "paths": [
        "services/backend/**",
        "db/**",
        "ops/**",
        "scripts/test_database.sh",
        "scripts/verify_core_provenance.py",
        "docs/CORE-PROVENANCE.json",
        "docs/DB-PROVENANCE.json",
        "docs/API-PROVENANCE.json",
        "docs/WATCHDOG-PROVENANCE.json",
        ".gitattributes",
        ".github/workflows/watchdog.yml"
      ]
    },
    "android": {
      "workflow": "android.yml",
      "paths": [
        "apps/android/**",
        "services/backend/src/avelren/api.py",
        "services/backend/src/avelren/schemas.py",
        "services/backend/src/avelren/subscriptions_api.py",
        "services/backend/src/avelren/admin_access_api.py",
        "services/backend/src/avelren/maintenance.py",
        "services/backend/src/avelren/surge*.py",
        "docs/ANDROID-PROVENANCE.json",
        "docs/ASSETS.md",
        "scripts/verify_android.py",
        "scripts/verify_push_qa.py",
        "scripts/verify_full_test.py",
        ".github/workflows/android.yml",
        ".gitattributes"
      ]
    },
    "repository": {
      "workflow": "repository.yml",
      "paths": [
        ".github/**",
        "docs/**",
        "scripts/**",
        "AGENTS.md",
        "CONTRIBUTING.md",
        "README.md"
      ]
    },
    "monitor_contracts": {
      "workflow": "external-monitor-checks.yml",
      "paths": [
        "scripts/classify_alert_channel.py",
        "scripts/tests/**",
        ".github/workflows/external-health-monitor.yml",
        ".github/workflows/external-monitor-checks.yml"
      ]
    },
    "supply_chain": {
      "workflow": "supply-chain.yml",
      "paths": []
    }
  },
  "all_components_paths": [
    ".github/workflows/**",
    ".github/ci-scopes.json",
    "scripts/ci_scopes.py",
    "scripts/verify_ci_gate.py",
    "scripts/verify_ci_scopes.py",
    "scripts/tests/test_ci_scopes.py",
    "scripts/tests/test_ci_gate.py",
    "scripts/tests/test_ci_workflow_contract.py"
  ],
  "docs_only_paths": [
    "docs/**/*.md",
    "README.md",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "INTEGRATION.md"
  ]
}
