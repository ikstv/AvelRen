# Скопіювати у .env для локального host configuration. Усі secret/DSN
# placeholders нижче навмисно порожні: не додавати прикладні або реальні значення.

# Сумісні non-secret defaults контейнера БД; пароль лишається порожнім у шаблоні.
POSTGRES_USER=avelren
POSTGRES_PASSWORD=
POSTGRES_DB=avelren
# Optional override лише для CI/non-Compose setup. У Compose залишити порожнім:
# кожен сервіс отримує власний DATABASE_URL із відповідного AVELREN_*_DSN.
DATABASE_URL=

# Сім окремих ролей PostgreSQL. Паролі й DSN завжди порожні в репозиторії.
# Реальні значення належать тільки авторизованому secret store/host configuration.
AVELREN_ADMIN_PASSWORD=
AVELREN_MIGRATOR_PASSWORD=
AVELREN_BACKUP_PASSWORD=
AVELREN_COLLECTOR_PASSWORD=
AVELREN_NOTIFIER_PASSWORD=
AVELREN_WATCHDOG_PASSWORD=
AVELREN_API_PASSWORD=
AVELREN_ADMIN_DSN=
AVELREN_MIGRATOR_DSN=
AVELREN_BACKUP_DSN=
AVELREN_COLLECTOR_DSN=
AVELREN_NOTIFIER_DSN=
AVELREN_WATCHDOG_DSN=
AVELREN_API_DSN=

# Джерело даних (public-source контракт v5)
ECHERHA_BASE_URL=https://back.echerha.gov.ua/api
ECHERHA_API_VERSION=5
ECHERHA_CLIENT_VERSION=3.9.0
# Persistent UUIDv4 гостьового клієнта. Згенерувати ОДИН раз (напр. `uuidgen`) і
# лишити незмінним між рестартами. Порожнє/невалідне/nil — collector fail-closed.
ECHERHA_DEVICE_ID=
# 1–120 друкованих ASCII-символів.
ECHERHA_DEVICE_NAME=AvelRen collector
ECHERHA_VEHICLE_TYPE=1
POLL_INTERVAL_SECONDS=60
HTTP_TIMEOUT_SECONDS=15

# Контакт у User-Agent, щоб держсервіс бачив, хто до нього ходить
CONTACT_EMAIL=

# Службовий ключ Firebase для пушів. Файл кладеться в ./secrets/ на сервері
# і в git не потрапляє.
FCM_CREDENTIALS_PATH=/secrets/firebase-service-account.json
ALERT_RESEND_SECONDS=300
REARM_FACTOR=0.9

LOG_LEVEL=INFO

# --- Опціональні tuning-knobs (audit F7) --------------------------------------
# Значення нижче = дефолти з app/src/avelren/config.py. Compose ці змінні НЕ
# прокидає (тож клас «порожній рядок перебиває code default», який поклав
# collector 2026-08-14 через REARM_FACTOR, тут не застосовний) — вони
# задокументовані, щоб тюнінг був видимий у шаблоні, а не прод-only дрейфом.
# Розкоментовувати лише разом із прокиданням у docker-compose.yml.
#
# Хост/порт Postgres для non-Compose запуску (у Compose сервіс завжди `db:5432`).
#POSTGRES_HOST=db
#POSTGRES_PORT=5432
# Стеля тіла запиту до public API, байти (limits.MAX_BODY_BYTES).
#API_MAX_BODY_BYTES=16384
# Одночасні «дорогі» запити (history/forecast) до API.
#API_MAX_CONCURRENT_EXPENSIVE=3
# statement_timeout для API-з'єднань, мс.
#API_STATEMENT_TIMEOUT_MS=5000
