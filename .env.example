# Скопіювати у .env і заповнити. Реальні значення в git не потрапляють.

POSTGRES_USER=avelren
POSTGRES_PASSWORD=
POSTGRES_DB=avelren
# Optional override for CI or a non-Compose operator setup. Leave empty in Compose.
DATABASE_URL=

# Джерело даних (public-source контракт v5)
ECHERHA_BASE_URL=https://back.echerha.gov.ua/api
ECHERHA_API_VERSION=5
ECHERHA_CLIENT_VERSION=3.9.0
# Persistent UUIDv4 гостьового клієнта. Згенерувати ОДИН раз (напр. `uuidgen`) і
# лишити незмінним між рестартами. Порожнє/невалідне/nil — collector fail-closed.
ECHERHA_DEVICE_ID=
# 1–120 друкованих ASCII-символів.
ECHERHA_DEVICE_NAME=AvelRen collector
ECHERHA_VEHICLE_TYPE=1
POLL_INTERVAL_SECONDS=60
HTTP_TIMEOUT_SECONDS=15

# Контакт у User-Agent, щоб держсервіс бачив, хто до нього ходить
CONTACT_EMAIL=

# Службовий ключ Firebase для пушів. Файл кладеться в ./secrets/ на сервері
# і в git не потрапляє.
FCM_CREDENTIALS_PATH=/secrets/firebase-service-account.json
ALERT_RESEND_SECONDS=300

LOG_LEVEL=INFO
