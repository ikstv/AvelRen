# Copy to .env for local host configuration. All secret/DSN placeholders below
# are deliberately empty: do not add example or real values.

# Compatible non-secret defaults for the DB container; the password stays empty
# in the template.
POSTGRES_USER=avelren
POSTGRES_PASSWORD=
POSTGRES_DB=avelren
# Optional override, only for a CI/non-Compose setup. Leave empty under Compose:
# each service gets its own DATABASE_URL from the corresponding AVELREN_*_DSN.
DATABASE_URL=

# Seven separate PostgreSQL roles. Passwords and DSNs are always empty in the
# repository. Real values belong only in the authorized secret store/host
# configuration.
AVELREN_ADMIN_PASSWORD=
AVELREN_MIGRATOR_PASSWORD=
AVELREN_BACKUP_PASSWORD=
AVELREN_COLLECTOR_PASSWORD=
AVELREN_NOTIFIER_PASSWORD=
AVELREN_WATCHDOG_PASSWORD=
AVELREN_API_PASSWORD=
AVELREN_ADMIN_DSN=
AVELREN_MIGRATOR_DSN=
AVELREN_BACKUP_DSN=
AVELREN_COLLECTOR_DSN=
AVELREN_NOTIFIER_DSN=
AVELREN_WATCHDOG_DSN=
AVELREN_API_DSN=

# Data source (public-source contract v5)
ECHERHA_BASE_URL=https://back.echerha.gov.ua/api
ECHERHA_API_VERSION=5
ECHERHA_CLIENT_VERSION=3.9.0
# Persistent UUIDv4 of the guest client. Generate it ONCE (e.g. `uuidgen`) and
# keep it unchanged across restarts. Empty/invalid/nil — collector fail-closed.
ECHERHA_DEVICE_ID=
# 1–120 printable ASCII characters.
ECHERHA_DEVICE_NAME=AvelRen collector
ECHERHA_VEHICLE_TYPE=1
POLL_INTERVAL_SECONDS=60
HTTP_TIMEOUT_SECONDS=15

# Contact in the User-Agent, so the government service can see who is calling it
CONTACT_EMAIL=

# Firebase service key for push. The file is placed in ./secrets/ on the server
# and never lands in git.
FCM_CREDENTIALS_PATH=/secrets/firebase-service-account.json
ALERT_RESEND_SECONDS=300
REARM_FACTOR=0.9

LOG_LEVEL=INFO

# --- Optional tuning knobs (audit F7) -----------------------------------------
# The values below = the defaults from app/src/avelren/config.py. Compose does
# NOT pass these variables through (so the class of bug where "an empty string
# overrides the code default", which took the collector down on 2026-08-14 via
# REARM_FACTOR, does not apply here) — they are documented so that tuning is
# visible in the template rather than a prod-only drift. Uncomment only together
# with passing them through in docker-compose.yml.
#
# Postgres host/port for a non-Compose run (under Compose the service is always
# `db:5432`).
#POSTGRES_HOST=db
#POSTGRES_PORT=5432
# Request-body ceiling for the public API, bytes (limits.MAX_BODY_BYTES).
#API_MAX_BODY_BYTES=16384
# Concurrent "expensive" requests (history/forecast) to the API.
#API_MAX_CONCURRENT_EXPENSIVE=3
# statement_timeout for API connections, ms.
#API_STATEMENT_TIMEOUT_MS=5000
