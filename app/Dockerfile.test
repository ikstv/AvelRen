# Pinned by digest — same as app/Dockerfile (issue #23).
FROM python:3.14-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /workspace

COPY app/pyproject.toml /workspace/app/
COPY app/src /workspace/app/src
COPY app/tests /workspace/app/tests
COPY db/migrations /workspace/db/migrations
# The restore-allowlist contract reconciles the allowlist in
# `restore-engine.lib.sh` with the schema — so both must be available in the
# test. This is not a backup script but a purely static-check artifact, with no
# secrets; it is safe to copy wholesale.
COPY deploy /workspace/deploy

RUN pip install --no-cache-dir ./app pytest ruff

CMD ["sh", "-c", "ruff check app/src app/tests && python -m avelren.migrate db/migrations && python -m pytest app/tests -q -p no:cacheprovider"]
