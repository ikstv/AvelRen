# Pinned by digest, not just a tag (issue #23, same convention as
# docker-compose.yml): a tag can be re-pushed to a different image, the
# digest cannot. Tag kept alongside for legibility; Dependabot's docker
# ecosystem for /app watches the digest and opens a PR when it moves.
FROM python:3.14-slim@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Dependencies come from a hash-pinned lock, not from resolving pyproject at
# build time (issue #23). pyproject pins only floors — `fastapi>=0.115` — so two
# builds of the same commit could ship different versions, and nothing recorded
# which. Measured while writing this: the image built at 13:42 today installed
# anyio 4.15.0, and a resolution four hours later produced 4.15.1.
#
# --require-hashes makes pip refuse anything whose artifact does not match, so a
# compromised or re-published wheel fails the build instead of shipping.
#
# Copied before src so the dependency layer is cached independently of code
# changes; the lock is regenerated by CI's freshness gate, never by hand.
COPY requirements.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements.lock

# --no-deps because the lock above is the complete, verified dependency set:
# without it pip would re-resolve the transitive tree and could pull something
# unhashed. The residual gap is honest rather than papered over — PEP 517 build
# isolation still fetches setuptools to build this package itself, and that fetch
# is not hash-pinned.
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps .

# The deploy's git SHA — set by CI/build.sh via `--build-arg SOURCE_COMMIT=$(git
# rev-parse HEAD)`. Available at runtime as env AVELREN_GIT_SHA and surfaced in
# /admin/telemetry.version. Default value is an empty string: better a null on
# the client than a fake "unknown".
ARG SOURCE_COMMIT=""
ENV AVELREN_GIT_SHA=${SOURCE_COMMIT}

# We do not run as root in the container.
RUN useradd --create-home --uid 10001 avelren
USER avelren

CMD ["python", "-m", "avelren.collector"]
